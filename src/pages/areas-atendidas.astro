---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { cidadesPorGrupo, cidadePath, grupoPrioritario } from '../data/cidades';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Cidades atendidas', path: '/areas-atendidas/' },
];
---

<Base
  title="Cidades Atendidas: Desentupidora 24h na Região de Campinas | Hidro Resolve"
  description={`Desentupidora 24 horas em Campinas, Valinhos, Vinhedo, Hortolândia e toda a região do DDD 19. Chegamos em até ${site.arrivalMinutes} minutos.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Cidades atendidas</span>
      <h1>Desentupidora em toda a região do 19</h1>
      <p class="hero-lead">Atendemos 24 horas, com foco em Campinas, Valinhos, Vinhedo e Hortolândia. Encontre a sua cidade.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container zones">
      {
        cidadesPorGrupo().map((g) => (
          <div class:list={['zone', { 'is-priority': g.grupo === grupoPrioritario }]}>
            <h2 style="font-size:1.6rem">
              {g.grupo}
              {g.grupo === grupoPrioritario && <span class="tag">Foco</span>}
            </h2>
            <ul>
              {g.cidades.map((c) => (
                <li>
                  <a href={cidadePath(c)}>
                    <Icon name="pin" size={16} /> Desentupidora em {c.nome}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <CtaBand />
</Base>

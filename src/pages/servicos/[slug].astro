---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico, temFotos } from '../../data/fotos';
import { site } from '../../data/site';
import { servicos, type Servico } from '../../data/servicos';
import { cidades, cidadePath } from '../../data/cidades';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/schema';

export function getStaticPaths() {
  return servicos.map((servico) => ({ params: { slug: servico.slug }, props: { servico } }));
}

interface Props {
  servico: Servico;
}

const { servico } = Astro.props;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
  { name: servico.nome, path: `/servicos/${servico.slug}/` },
];
const faq = [
  ...servico.faq,
  {
    q: `Em quanto tempo vocês chegam para ${servico.nome.toLowerCase()}?`,
    a: `Atendemos 24 horas e chegamos em até ${site.arrivalMinutes} minutos em Campinas e nas cidades da região.`,
  },
];
const foto = fotoDoServico(servico.slug);
const outros = servicos.filter((s) => s.slug !== servico.slug).slice(0, 8);
const msg = `Olá! Vim pelo site e preciso de ${servico.nome.toLowerCase()}.`;
---

<Base
  title={`${servico.keyword}${servico.keyword.includes('24 horas') ? '' : ' 24h'} | Hidro Resolve`}
  description={servico.metaDescription}
  schema={[serviceSchema(servico), faqSchema(faq), breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Serviço 24 horas em {site.region}</span>
      <h1>{servico.keyword}</h1>
      <p class="hero-lead">{servico.resumo} Atendimento emergencial 24h, com chegada em até {site.arrivalMinutes} minutos.</p>
      <CtaButtons message={msg} />
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <article class="prose">
        {servico.intro.map((p) => <p>{p}</p>)}

        {
          foto && (
            <figure class="service-figure">
              <Image src={foto.src} alt={foto.alt} widths={[480, 800, 1100]} sizes="(max-width: 960px) 100vw, 760px" />
              <figcaption>{servico.nome} 24 horas em {site.region}.</figcaption>
            </figure>
          )
        }

        <h2>Quando chamar a desentupidora</h2>
        <ul>{servico.sinais.map((s) => <li>{s}</li>)}</ul>

        <h2>Como fazemos o serviço</h2>
        <ol>{servico.comoFazemos.map((s) => <li>{s}</li>)}</ol>

        <h2>Por que chamar a Hidro Resolve</h2>
        <ul>
          <li>Atendimento 24 horas, inclusive fins de semana e feriados</li>
          <li>Chegada em até {site.arrivalMinutes} minutos</li>
          <li>Atendimento emergencial, sem quebra-quebra sempre que possível</li>
          <li>Equipe equipada com máquinas rotativas, hidrojateamento e caminhão limpa fossa</li>
        </ul>

        <h2>Perguntas frequentes</h2>
        <FaqList items={faq} />

        <h2>{servico.nome} por cidade</h2>
        <p>
          Atendemos {servico.nome.toLowerCase()} em Campinas e em toda a região do DDD 19, incluindo:
          {cidades.map((c, i) => (
            <>
              <a href={cidadePath(c)}>{c.nome}</a>{i < cidades.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h2>Atendimento imediato</h2>
          <p>Fale agora com a desentupidora e receba atendimento em até {site.arrivalMinutes} minutos.</p>
          <CtaButtons message={msg} size="md" />
        </div>
        <div class="side-list">
          <h2>Outros serviços</h2>
          <ul>
            {outros.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
            <li><a href="/servicos/"><strong>Ver todos <Icon name="arrow" size={14} /></strong></a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    temFotos() && (
      <section class="section section-soft">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Outros serviços</span>
            <h2>Conheça outros serviços</h2>
          </div>
          <Gallery limit={8} exclude={servico.slug} />
        </div>
      </section>
    )
  }

  <CtaBand message={msg} />
</Base>

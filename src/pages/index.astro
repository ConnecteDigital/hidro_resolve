---
import Base from '../layouts/Base.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import { Image } from 'astro:assets';
import { fotoDoServico, temFotos } from '../data/fotos';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { cidadesPorGrupo, cidadePath, grupoPrioritario } from '../data/cidades';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const faq = [
  {
    q: 'A desentupidora atende 24 horas mesmo?',
    a: 'Sim. Atendemos 24 horas por dia, 7 dias por semana, incluindo madrugadas, fins de semana e feriados.',
  },
  {
    q: 'Em quanto tempo vocês chegam?',
    a: `Nossa equipe chega em até ${site.arrivalMinutes} minutos nas cidades atendidas.`,
  },
  {
    q: 'Quais cidades vocês atendem?',
    a: 'Campinas, Valinhos, Vinhedo, Hortolândia e toda a região do DDD 19, como Sumaré, Paulínia, Indaiatuba, Americana, Jaguariúna e Itatiba.',
  },
  {
    q: 'Vocês fazem limpeza de fossa?',
    a: 'Sim. Fazemos limpa fossa com caminhão a vácuo em casas, chácaras, sítios, condomínios e empresas, além de limpeza de caixa de gordura.',
  },
  {
    q: 'Precisa quebrar piso ou parede para desentupir?',
    a: 'Na grande maioria dos casos, não. Usamos máquinas rotativas e hidrojateamento que alcançam a obstrução por dentro da tubulação.',
  },
  {
    q: 'Como chamo a desentupidora?',
    a: `É só chamar no WhatsApp ou ligar. Conte o que está acontecendo, de preferência com uma foto ou vídeo, e a equipe sai na hora para chegar em até ${site.arrivalMinutes} minutos.`,
  },
];

const fotoHero = fotoDoServico('desentupimento-de-esgoto');
const fotoSobre = fotoDoServico('hidrojateamento') ?? fotoHero;
const mostrarGaleria = temFotos();

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Base
  title="Desentupidora 24 Horas no Interior | Chegamos em 20 min | Hidro Resolve"
  description={site.description}
  schema={[faqSchema(faq)]}
>
  <section class="hero hero-home">
    {
      fotoHero && (
        <Image
          class="hero-bg"
          src={fotoHero.src}
          alt=""
          widths={[480, 800, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container hero-center">
      <span class="eyebrow">Desentupidora e limpa fossa · Atendimento emergencial</span>
      <h1>Desentupidora 24 horas no interior: <em>chegamos em até {site.arrivalMinutes} minutos</em></h1>
      <p class="hero-lead">Pia, vaso, ralo, esgoto ou fossa cheia? Resolvemos agora, a qualquer hora, sem quebra-quebra.</p>
      <CtaButtons />
      <ul class="hero-badges">
        <li><Icon name="clock" size={22} /> <span>Atendimento 24h</span></li>
        <li><Icon name="bolt" size={22} /> <span>Chegada em até {site.arrivalMinutes} min</span></li>
        <li><Icon name="truck" size={22} /> <span>Limpa fossa</span></li>
      </ul>
    </div>
  </section>

  <section class="trust" aria-label="Diferenciais">
    <div class="container trust-grid">
      <div class="trust-item"><Icon name="clock" size={34} /><div><strong>24 horas</strong><span>Todos os dias, inclusive feriados</span></div></div>
      <div class="trust-item"><Icon name="bolt" size={34} /><div><strong>{site.arrivalMinutes} minutos</strong><span>Tempo de chegada</span></div></div>
      <div class="trust-item"><Icon name="jet" size={34} /><div><strong>Sem quebra-quebra</strong><span>Máquinas e hidrojateamento</span></div></div>
      <div class="trust-item"><Icon name="pin" size={34} /><div><strong>Região do 19</strong><span>Campinas, Valinhos, Vinhedo e mais</span></div></div>
    </div>
  </section>

  <section class="section section-soft" id="servicos">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nossos serviços</span>
        <h2>Serviços de desentupidora</h2>
        <p>Da pia entupida à limpeza de fossa: desentupimos e limpamos toda a parte de esgoto da sua casa, condomínio ou empresa.</p>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Como funciona</span>
        <h2>Do chamado ao esgoto correndo</h2>
        <p>Sem enrolação: você chama, a gente chega e desentope.</p>
      </div>
      <div class="steps">
        <div class="step-card">
          <h3>Chame no WhatsApp ou ligue</h3>
          <p>Conte o que está acontecendo. Se puder, mande uma foto ou um vídeo do problema.</p>
        </div>
        <div class="step-card">
          <h3>Chegamos em até {site.arrivalMinutes} minutos</h3>
          <p>Assim que você chama, a equipe já sai para o endereço com o equipamento certo para o seu caso.</p>
        </div>
        <div class="step-card">
          <h3>Desentupido e testado</h3>
          <p>Desobstruímos, testamos o escoamento na sua frente e deixamos o local limpo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class:list={['container', { 'about-grid': fotoSobre }]}>
      {
        fotoSobre && (
          <div class="about-photo">
            <Image src={fotoSobre.src} alt={fotoSobre.alt} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" />
          </div>
        )
      }
      <div>
      <div class="section-head">
        <span class="eyebrow">Por que a Hidro Resolve</span>
        <h2>Desentupidora de confiança, a qualquer hora</h2>
        <p>Equipe preparada para resolver desde um ralo entupido até a limpeza de rede de condomínio e o esgotamento de fossa.</p>
      </div>
      <div class="features">
        <div class="feature">
          <Icon name="clock" size={30} />
          <div><h3>Plantão 24 horas</h3><p>Entupimento não espera horário comercial. Atendemos de madrugada, fins de semana e feriados.</p></div>
        </div>
        <div class="feature">
          <Icon name="bolt" size={30} />
          <div><h3>Chegamos em {site.arrivalMinutes} minutos</h3><p>Atendimento emergencial: em até {site.arrivalMinutes} minutos a equipe está na sua porta.</p></div>
        </div>
        <div class="feature">
          <Icon name="jet" size={30} />
          <div><h3>Equipamento certo</h3><p>Máquinas de cabo rotativo, hidrojateamento e caminhão limpa fossa para cada tipo de serviço.</p></div>
        </div>
        <div class="feature">
          <Icon name="check" size={30} />
          <div><h3>Sem quebra-quebra</h3><p>Desentupimos por dentro da tubulação. Só abrimos piso ou parede quando não há outro jeito, e com o seu aceite.</p></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <CtaBand />

  {
    mostrarGaleria && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Trabalhos realizados</span>
            <h2>Serviços que já fizemos</h2>
            <p>Fotos reais de atendimentos da Hidro Resolve.</p>
          </div>
          <Gallery limit={8} />
        </div>
      </section>
    )
  }

  <section class="section section-soft" id="areas">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cidades atendidas</span>
        <h2>Desentupidora perto de você</h2>
        <p>Atendemos toda a região do DDD 19, com foco em Campinas, Valinhos, Vinhedo e Hortolândia.</p>
      </div>
      <div class="zones">
        {
          cidadesPorGrupo().map((g) => (
            <div class:list={['zone', { 'is-priority': g.grupo === grupoPrioritario }]}>
              <h3>
                {g.grupo}
                {g.grupo === grupoPrioritario && <span class="tag">Foco</span>}
              </h3>
              <ul>
                {g.cidades.map((c) => (
                  <li>
                    <a href={cidadePath(c)}>
                      <Icon name="pin" size={16} /> Desentupidora em {c.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Blog</span>
            <h2>Dicas contra entupimento</h2>
          </div>
          <div class="posts">
            {posts.map((p) => (
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.data.toISOString()}>{p.data.data.toLocaleDateString('pt-BR')}</time>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.descricao}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-soft">
    <div class="container" style="max-width: 860px">
      <div class="section-head">
        <span class="eyebrow">Dúvidas frequentes</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand title="Precisa de uma desentupidora agora?" />
</Base>

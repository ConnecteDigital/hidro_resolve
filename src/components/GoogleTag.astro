---
// Tag do Google (gtag.js), em todas as páginas. Só é instalada se googleTagId estiver preenchido.
import { googleTagId } from '../data/site';
---

{
  googleTagId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleTagId}`} />
      <script is:inline define:vars={{ googleTagId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', googleTagId);
      </script>
    </>
  )
}

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { cidades, cidadePath } from '../data/cidades';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo width={260} />
      <p>Desentupidora e limpa fossa 24 horas em {site.region}. Atendimento emergencial com chegada em até {site.arrivalMinutes} minutos.</p>
      <ul class="footer-contact">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a></li>
        <li><a href={site.tel}><Icon name="phone" size={18} /> {site.phoneDisplay}</a></li>
        <li><Icon name="clock" size={18} /> Aberto 24 horas, todos os dias</li>
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Serviços</h2>
      <ul class="footer-links">
        {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Desentupidora por cidade</h2>
      <ul class="footer-links">
        {cidades.map((c) => <li><a href={cidadePath(c)}>Desentupidora em {c.nome}</a></li>)}
      </ul>
      <h2 class="footer-title">Conteúdo</h2>
      <ul class="footer-links">
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/areas-atendidas/">Cidades atendidas</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
  </div>
</footer>

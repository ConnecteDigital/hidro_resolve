---
// Logo oficial da Hidro Resolve (src/assets/logo.png, fundo transparente).
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

interface Props {
  height?: number;
  class?: string;
  eager?: boolean;
}
const { height = 76, class: className, eager = false } = Astro.props;
---

<Image
  src={logo}
  alt={`${site.name} Desentupidora`}
  height={height}
  densities={[1, 2]}
  class:list={['logo', className]}
  loading={eager ? 'eager' : 'lazy'}
/>
